{
  "name": "afterhours-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Cloudflare Worker that turns a concept into an AFTERHOURS brandbook without exposing the Gemini key.",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "build:test": "esbuild src/index.ts --bundle --format=esm --target=es2022 --loader:.md=text --log-level=warning --outfile=dist/worker.js",
    "test": "npm run build:test && node --test \"test/**/*.test.mjs\""
  },
  "dependencies": {
    "@cfworker/json-schema": "4.1.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "esbuild": "^0.28.2",
    "typescript": "~6.0.3",
    "wrangler": "^4.152.0"
  }
}
