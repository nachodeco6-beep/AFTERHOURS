# Dirección del Worker de búsqueda (ver worker/README.md), sin barra al final.
# Copiá este archivo como .env.local (desarrollo) y completala. Vacía = modo demo.
# La URL de la versión publicada va en .env.production.
VITE_SEARCH_API_URL=

# Dirección del Worker de IA (ver worker-ai/README.md), sin barra al final.
# En desarrollo suele ser la de «wrangler dev»: http://localhost:8787
# Vacía = la IA queda apagada y la web funciona en modo clásico.
VITE_AI_API_URL=

# Clave de sitio de Turnstile (pública, no es un secreto). El widget es invisible.
# Para desarrollo sirve la clave de prueba del widget invisible que siempre pasa:
# VITE_TURNSTILE_SITE_KEY=1x00000000000000000000BB
# (el Worker local necesita el secreto de prueba 1x0000000000000000000000000000000AA)
VITE_TURNSTILE_SITE_KEY=
