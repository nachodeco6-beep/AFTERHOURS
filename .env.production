# URL pública del Worker de búsqueda (ver worker/README.md), sin barra al final.
# La usa «npm run build» / «npm run deploy» para la versión publicada.
# Esta dirección NO es secreta y por eso este archivo está versionado.
# NUNCA pongas acá la clave de Unsplash: la clave vive solo como secreto en el Worker.
# Vacía = la web publicada sale en modo demo.
VITE_SEARCH_API_URL=https://afterhours-search.nachodeco6.workers.dev

# URL pública del Worker de IA (worker-ai/) y clave de sitio de Turnstile.
# Ninguna de las dos es secreta. Quedan VACÍAS hasta publicar el Worker (W4):
# vacías = la IA apagada y la web publicada sigue en modo clásico.
VITE_AI_API_URL=
VITE_TURNSTILE_SITE_KEY=
